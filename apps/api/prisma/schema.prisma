generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  PROJECT_MANAGER
  QA
  DEVELOPER
}

model User {
  id       String @id @default(uuid())
  name     String
  email    String @unique
  password String
  role     Role   @default(DEVELOPER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
